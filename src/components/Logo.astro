---
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
const wordSize = `${Math.round(size * 0.5 * 100) / 100}px`;
const gap = `${Math.round(size * 0.3 * 100) / 100}px`;
---

<span class={`inline-flex items-center ${className ?? ''}`} style={`gap: ${gap}`}>
  <svg
    viewBox="80 80 570 400"
    style={`height: ${size}px; width: auto;`}
    aria-hidden="true"
  >
    <polygon points="90,160 180,110 250,255 160,305" fill="#f1ebdd"></polygon>
    <polygon
      points="275,210 475,90 460,255 510,345 375,465 275,290"
      fill="#e3b341"></polygon>
    <polygon points="485,205 640,95 605,245 525,320 470,250" fill="#87956a"
    ></polygon>
  </svg>
  <span class="sr-only">Woksar</span>
  <span
    aria-hidden="true"
    class="font-display font-extrabold uppercase leading-none tracking-[0.04em] text-foreground"
    style={`font-size: ${wordSize}`}
  >
    Woksar
  </span>
</span>
