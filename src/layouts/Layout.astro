---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import {
  getContent,
  localePath,
  locales,
  site,
  type Locale,
} from '@/i18n';

interface Props {
  locale: Locale;
  path?: string;
  title?: string;
  description?: string;
}

const { locale, path = '/', title, description } = Astro.props;
const t = getContent(locale);

const canonical = new URL(localePath(locale, path), Astro.site);
const ogImage = new URL(t.meta.ogImage, Astro.site);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#11130f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      locales.map((code) => (
        <link
          rel="alternate"
          hreflang={getContent(code).htmlLang}
          href={new URL(localePath(code, path), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath('pt', path), Astro.site)}
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fustat:wght@200..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&family=Fraunces:opsz,wght@9..144,300..700&display=swap"
    />

    <title>{pageTitle}</title>

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="bg-surface text-foreground antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-brand focus:px-5 focus:py-2 focus:text-sm focus:font-medium focus:text-brand-foreground"
    >
      {t.ui.skipToContent}
    </a>
    <Nav locale={locale} path={path} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      import { initReveal } from '@/scripts/reveal';
      import { initScramble } from '@/scripts/scramble';
      import { initMenu } from '@/scripts/menu';
      import { initStepper } from '@/scripts/stepper';

      function boot() {
        initReveal();
        initScramble();
        initMenu();
        initStepper();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', boot, { once: true });
      } else {
        boot();
      }
    </script>
  </body>
</html>
